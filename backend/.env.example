# Copy this file to .env and replace with your real credentials
PORT=5577
NODE_ENV=production

# Database: "mariadb" (default) or "mysql" (for PlanetScale, etc.)
DB_DIALECT=mariadb
# Set to "true" for PlanetScale / managed MySQL requiring SSL
DB_SSL=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_system
DB_USER=root
DB_PASS=

JWT_SECRET=

COMPANY_NAME=Your Company Name
COMPANY_SHORT_NAME=ERP
COMPANY_TAGLINE=Business Management Platform
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_PINCODE=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_WHATSAPP=
COMPANY_LOGO_URL=

FRONTEND_URL=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/auth/login

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=

WHATSAPP_API_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CERT_SIGNATORY_NAME=
CERT_SIGNATORY_ROLE=

SMARTFLO_USER=
SMARTFLO_PASS=
PUPPETEER_EXECUTABLE_PATH=
